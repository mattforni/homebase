# ~/.aliases: included by ~/.zshrc to make life easier
# General Aliases
alias bell="echo -ne '\007'"
alias ed-aliases="vim ~/.aliases"
alias ed-env="vim ~/.env.local"
alias ed-functions="vim ~/.functions"
alias rest-now="sudo shutdown -r now"
alias todo="grep -Irn --exclude=\"*\.git*\" \"TODO\" ."
alias upgrade="sudo apt-get update && sudo apt-get upgrade -y && sudo apt-get autoremove"

# LS(1) Aliases
alias ll="ls -l"
alias la="ls -a"
alias lla="ls -la"

# Screen Aliases
alias scr="screen -S"
alias skill="screen -ls | grep Detached | cut -d. -f1 | awk '{print $1}' | xargs kill"
alias sls="screen -ls"
alias sra="screen -d -RR"
alias sw="screen -wipe"

# CodeRabbit
alias cr="coderabbit"

# Docker Aliases
alias docker-clean='docker rm $(docker ps -a -q -f status=exited)'
alias docker-clean-all='docker-stop; docker-clean; docker-clean-images'
alias docker-clean-images='docker rmi $(docker images -a -q)'
alias docker-stop='docker stop $(docker ps -a -q)'

# IDE Aliases
# Antigravity is the only IDE; its user settings live under Application Support,
# not in a dotfile. Deployed there from ide/settings.json by setup.sh.
alias ed-ide-settings='vim "$HOME/Library/Application Support/Antigravity IDE/User/settings.json"'

# Navigation Aliases
alias homebase="cd ~/Eudaimonia/Craft/Development/personal/homebase"
alias eudy="cd ~/Eudaimonia"

# Zsh Aliases
alias ed-zsh="vim ~/.zshrc"
alias src-zsh="source ~/.zshrc"

# Claude Aliases
alias cc="claude"
alias ccr="claude --continue"

# Rails Aliases
alias rc='type rails >/dev/null 2>&1 && LLM_ENABLED=false rails console'
alias rc-railway='railway ssh "bundle exec rails console"'
alias rf='type foreman >/dev/null 2>&1 && bundle exec foreman start'
alias rk='bundle exec sidekiq -c 2'
alias rs='type rails >/dev/null 2>&1 && LLM_ENABLED=false rails server'
