    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "skill-creator@claude-plugins-official": true,
    "assist@local-skills": true,
    "linear-lifecycle@skillset": true,
    "sdlc@skillset": true
  },
  "extraKnownMarketplaces": {
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-code.git"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "local-skills": {
      "source": {
        "source": "directory",
        "path": "$HOME/.claude/local-skills"
      }
    },
    "skillset": {
      "source": {
        "source": "github",
        "repo": "mattforni/homebase"
      }
    }
  },
  "outputStyle": "Forni",
  "alwaysThinkingEnabled": true,
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/merge-gate.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/land-via-lander.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/land-via-lander.sh"
          }
        ]
      }
    ]
  },
  "subagentPromptCacheTtl": "1h",
  "claudeMdExcludes": [
    "**/homebase*/.claude/CLAUDE.md"
  ],
  "effortLevel": "medium"
}
