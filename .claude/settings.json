{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "allow": [
      "Bash(agent-browser --session myui --identity personal --headed:*)",
      "Bash(awk:*)",
      "Bash(brew:*)",
      "Bash(bun:*)",
      "Bash(bundle:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(claude:*)",
      "Bash(cp:*)",
      "Bash(date:*)",
      "Bash(dig:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(gcloud:*)",
      "Bash(gem:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(gunzip:*)",
      "Bash(gws:*)",
      "Bash(head:*)",
      "Bash(hs:*)",
      "Bash(linear:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(magick:*)",
      "Bash(markdownlint:*)",
      "Bash(mdls *)",
      "Bash(mise:*)",
      "Bash(mkdir:*)",
      "Bash(npm:*)",
      "Bash(pip3:*)",
      "Bash(pkill:*)",
      "Bash(pnpm:*)",
      "Bash(railway:*)",
      "Bash(rsvg-convert:*)",
      "Bash(rsync:*)",
      "Bash(sed:*)",
      "Bash(sips:*)",
      "Bash(sort:*)",
      "Bash(sqlite3:*)",
      "Bash(tail:*)",
      "Bash(td:*)",
      "Bash(test:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(unzip:*)",
      "Bash(vercel:*)",
      "Bash(wc:*)",
      "Bash(ynab:*)",
      "Read(//$HOME/**)",
      "Skill(assist:*)",
      "Skill(sdlc:*)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.coderabbit.ai)",
      "WebFetch(domain:docs.railway.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:job-boards.greenhouse.io)",
      "WebFetch(domain:jobs.ashbyhq.com)",
      "WebFetch(domain:jobs.lever.co)",
      "WebFetch(domain:jobs.mcj.vc)",
      "WebFetch(domain:linear.app)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:newsletter.pragmaticengineer.com)",
      "WebFetch(domain:notes.granola.ai)",
      "WebFetch(domain:posthog.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:support.gusto.com)",
      "WebFetch(domain:uploads.linear.app)",
      "WebFetch(domain:www.amazon.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:www.booking.com)",
      "WebFetch(domain:www.coloradosos.gov)",
      "WebFetch(domain:www.linkedin.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:www.projectangelheart.org)",
      "WebSearch"
    ],
    "deny": [
      "Bash(agent-browser *chkEnhancedConfirmation*)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Label, star, read state, and archive changes to Gmail threads in Forni's own mailboxes through the gws CLI (gmail users threads modify, messages modify, batchModify), run directly or from a script. These are reversible triage housekeeping, pre authorized by Forni on 2026-10-05 for agents executing an inbox board. Sending or drafting mail, trashing or deleting, unsubscribing, and filter changes are not covered.",
      "During an audit of a prospect's or client's public website for the Atelic practice, clicking that site's own public lead actions in agent-browser (a Book Online or Schedule link, a tel: link, a directions link) to read which analytics and conversion tags fire. The click opens a page or a dialer prompt and nothing more. Pre authorized by Forni on 2026-10-05. Filling or submitting a form, starting or completing a booking, entering any personal or payment detail, and placing a call are not covered.",
      "Running the CodeRabbit CLI review (coderabbit review --base origin/main --committed --agent) through a small wrapper script that changes into a git worktree first, including a worktree of a repo cloned inside the session's own worktree. The review is read only. Pre authorized by Forni on 2026-10-05. Git commands inside the wrapper are not covered."
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "assist@local-skills": true,
    "sdlc@skillset": true,
    "cowork-plugin-management@synced": false
  },
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "dataviz": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "artifact-design": "user-invocable-only",
    "artifact-diagramming": "user-invocable-only",
    "artifact-capabilities": "user-invocable-only",
    "workflow-authoring": "user-invocable-only",
    "schedule": "user-invocable-only",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "security-review": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "run": "user-invocable-only",
    "init": "user-invocable-only"
  },
  "deniedMcpServers": [
    { "serverName": "claude.ai Claude Docs" },
    { "serverName": "claude.ai Google Drive" }
  ],
  "extraKnownMarketplaces": {
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-code.git"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "local-skills": {
      "source": {
        "source": "directory",
        "path": "$HOME/.claude/local-skills"
      }
    },
    "skillset": {
      "source": {
        "source": "github",
        "repo": "mattforni/homebase"
      }
    }
  },
  "outputStyle": "Forni",
  "alwaysThinkingEnabled": true,
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/merge-gate.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/land-via-lander.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/secrets-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/voice-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/land-via-lander.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/compact-context.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "subagentPromptCacheTtl": "1h",
  "claudeMdExcludes": [
    "**/homebase*/.claude/CLAUDE.md"
  ],
  "effortLevel": "medium"
}
