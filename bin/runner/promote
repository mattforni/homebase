#!/usr/bin/env bash
# Promote a runner to production: build its image and point its job at it.
#
# Usage: promote <runner-name> [--dirty] [--tag <tag>]
#
# The two gcloud commands this wraps lived only in a README code block, which
# meant production was something retyped from documentation every time. Cloud
# Build does the build, so no local Docker daemon is involved.
#
# By default this refuses to promote a runner whose files are not committed,
# because an image built from a dirty tree is a production artifact nobody can
# reproduce or reason about later. --dirty is the deliberate override.
#
# Once the job points at the new image, every other image of the runner is
# deleted from the registry.
set -euo pipefail

LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
[[ -r "$LIB" ]] || { echo "cannot read $LIB" >&2; exit 1; }
# shellcheck source=lib.sh
. "$LIB"

name=""; allow_dirty=0; tag="latest"
while (( $# )); do
    case "$1" in
        --dirty)   allow_dirty=1; shift ;;
        --tag)     tag="${2:-}"; shift 2 ;;
        -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)        die "unknown option $1" ;;
        *)         [[ -z "$name" ]] || die "unexpected argument $1"; name="$1"; shift ;;
    esac
done

dir="$(runner_dir "$name")"

# A runner without a Dockerfile is local only, which is a design position and
# not an unfinished one: it may drive the local CLIs or a real browser, and
# neither survives a container without work that has to be decided rather than
# assumed. Say so plainly instead of failing inside Cloud Build.
[[ -f "$dir/Dockerfile" ]] || die "$name has no Dockerfile, so it is a local only runner and production for it is launchd. runners/$name/README.md says what promoting it would take."

command -v gcloud >/dev/null 2>&1 || die "gcloud not found on PATH"

root="$(runner_repo_root)"
# The image is built from a staged context (the runner, the shared library, the
# node renderer, any agent it ships), so every source has to be clean for the
# artifact to be reproducible.
dirty="$(git -C "$root" status --porcelain -- "runners/$name" runners/lib runners/email .claude/agents)" \
    || die "could not read the working tree state of $root; the dirty gate cannot pass on a guess"
if [[ -n "$dirty" && $allow_dirty -eq 0 ]]; then
    echo "runners/$name, runners/lib, runners/email or .claude/agents has uncommitted changes:" >&2
    printf '%s\n' "$dirty" >&2
    die "commit them, or pass --dirty to promote anyway"
fi

context="$(runner_build_context "$dir")" || die "could not stage the build context for $name"
image="$RUNNER_REGISTRY/$name:$tag"
echo "building $image from $context"

# Submitted without waiting, and the wait done here, because gcloud's own wait
# is welded to its log tail. The tail reads the build's log out of Cloud
# Build's default logs bucket, which only a project Viewer or Owner may read,
# and when that read is refused gcloud waits the build out and then exits non
# zero with "This tool can only stream logs if you are Viewer/Owner of the
# project", whatever the build did. The deploy identity the promote workflow
# runs as is not a Viewer and should not be: the first automatic promotes
# built all three images and then stopped right here, with every job still on
# its old one (2026-10-07). --suppress-logs is no way out. It only takes the
# output stream away; the tail still polls the bucket and raises the same
# refusal (googlecloudsdk/api_lib/cloudbuild/logs.py, SDK 588).
#
# So the result is read from the build's status, which needs nothing beyond
# the right to see the build, and the log is a courtesy tried for every caller
# alike: a person at a terminal watches it live exactly as before, and a
# caller who may not read it gets one line saying so. One path, with no test
# for where it is running. The one thing given up is that Ctrl C no longer
# cancels the build; `gcloud builds cancel` with the id printed below does.
submitted="$(gcloud builds submit "$context" --tag "$image" --project="$RUNNER_PROJECT" \
    --async --format='value(id,logUrl)')" \
    || die "Cloud Build did not accept the build for $name"
build_id="${submitted%%$'\t'*}"
[[ -n "$build_id" ]] || die "Cloud Build accepted the build for $name and returned no id"
build_url=""
[[ "$submitted" != *$'\t'* ]] || build_url="${submitted#*$'\t'}"
[[ -n "$build_url" ]] || build_url="https://console.cloud.google.com/cloud-build/builds/$build_id?project=$RUNNER_PROJECT"
echo "build $build_id"
echo "console: $build_url"

# The log, live, for whoever may read it. It returns when the build ends
# either way; a refusal is one line and anything else is shown as it came.
stream_err="$(mktemp)"
if ! gcloud builds log --stream "$build_id" --project="$RUNNER_PROJECT" 2>"$stream_err"; then
    if grep -q "can only stream logs" "$stream_err"; then
        echo "this identity may not read the build log, so the build is followed by its status alone; the log is at the console link above"
    else
        cat "$stream_err" >&2
        echo "the build log could not be followed; waiting on the build's status instead" >&2
    fi
fi
rm -f "$stream_err"

# The verdict. A read that fails is retried a few times before it is believed,
# since one dropped call must not fail a promote whose build is fine.
misses=0
while :; do
    if build_status="$(gcloud builds describe "$build_id" --project="$RUNNER_PROJECT" \
        --format='value(status)' 2>/dev/null)" && [[ -n "$build_status" ]]; then
        misses=0
        case "$build_status" in
            SUCCESS) break ;;
            QUEUED|PENDING|WORKING|STATUS_UNKNOWN) ;;
            *) die "build $build_id ended as $build_status, so $name is not promoted and its job still points at the image it had. Read the log at $build_url or, as a project Viewer, with: gcloud builds log $build_id --project=$RUNNER_PROJECT" ;;
        esac
    else
        misses=$((misses + 1))
        (( misses < 6 )) || die "could not read the status of build $build_id after $misses tries, so $name is not promoted. See $build_url"
    fi
    sleep 5
done
echo "build $build_id succeeded"

echo "pointing the job at it"
gcloud run jobs update "$name" --project="$RUNNER_PROJECT" --region="$RUNNER_REGION" --image="$image"

# Every earlier image goes the moment the new one is live (Forni, 2026-09-27):
# nothing rolls back to an old digest, and keeping them left about 10 GB in
# the registry, billed past the free half gigabyte. The prune keys on the digest
# the job now runs, not on a tag, and a failure here only warns, since the
# promote itself has already succeeded.
prune_old_images() {
    local current digest versions
    current="$(gcloud artifacts docker images describe "$image" --project="$RUNNER_PROJECT" \
        --format='value(image_summary.digest)')" || return 1
    [[ -n "$current" ]] || return 1
    versions="$(gcloud artifacts docker images list "$RUNNER_REGISTRY/$name" --project="$RUNNER_PROJECT" \
        --format='value(version)')" || return 1
    while read -r digest; do
        [[ -n "$digest" && "$digest" != "$current" ]] || continue
        gcloud artifacts docker images delete "$RUNNER_REGISTRY/$name@$digest" \
            --project="$RUNNER_PROJECT" --delete-tags --quiet >/dev/null 2>&1 || return 1
        echo "pruned $name@${digest:7:12}"
    done <<< "$versions"
}
echo "pruning earlier images"
prune_old_images || echo "WARNING: pruning the earlier $name images did not finish; the promote stands, and the next one retries"

echo "promoted $name. Fire it with: bin/runner/fire $name"
