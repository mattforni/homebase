#!/usr/bin/env bash
# Mail a runner's rendered email to Forni, for looking at a draft in the place
# it will actually be read.
#
# Usage: mail <runner-name> [--subject "..."]
#
# A browser preview is not the artifact. Gmail collapses styles, rewrites some
# markup, and renders on a phone, so a table that lines up in Chrome can still
# arrive broken. This sends the exact bytes the runner rendered, through the
# same Resend sender and to the same recipient a real run uses.
#
# It sends only what is already rendered; run render-local or run-local first.
set -euo pipefail

LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
[[ -r "$LIB" ]] || { echo "cannot read $LIB" >&2; exit 1; }
# shellcheck source=lib.sh
. "$LIB"

name=""; subject=""
while (( $# )); do
    case "$1" in
        --subject)  subject="${2:-}"; shift 2 ;;
        -h|--help)  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)         die "unknown option $1" ;;
        *)          [[ -z "$name" ]] || die "unexpected argument $1"; name="$1"; shift ;;
    esac
done

dir="$(runner_dir "$name")"
work="$dir/out"
html="$(runner_email_artifact "$work")" \
    || die "nothing rendered in $work; run 'bin/runner/run-local $name' first"

week=""
[[ -r "$work/week.env" ]] && week="$(sed -n 's/^WEEK=//p' "$work/week.env" | head -1)"
# The subject wears the title the runner names itself with in runner_init
# ("Outreach"), the same one a real run sends under, never the directory name.
title="$(sed -n 's/^runner_init [^ ]* "\([^"]*\)".*/\1/p' "$dir/entrypoint.sh" | head -1)"
title="${title:-$name}"
# Every draft gets its own subject. Gmail threads messages that share one and
# then hides the parts a later message repeats behind its trimmed content
# button, so a second draft of the same week arrives with its tables collapsed
# and reads as broken markup rather than as a repeat. A real run sends one
# email a week and never hits this.
subject="${subject:-${week:-$(date +%G-W%V)} $title (draft $(date +%H:%M))}"

# The send itself comes from the entrypoint side library, so there is one
# Resend implementation rather than one here and another in every runner. The
# credentials come from the driver side, because that half is what is allowed
# to know this machine has a Keychain.
LIB_ENTRY="$(runner_entrypoint_lib)"
[[ -r "$LIB_ENTRY" ]] || die "cannot read $LIB_ENTRY"
# shellcheck source=../../runners/lib/runner.sh
. "$LIB_ENTRY"
runner_local_credentials "$name"

send_email "$subject" "$(cat "$html")"
