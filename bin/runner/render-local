#!/usr/bin/env bash
# Re-render a runner's saved draft through its renderer.
#
# Usage: render-local <runner-name> [--week YYYY-Www] [--json <file>] [--no-open]
#
# No network, no model, no credentials: this reads the JSON a previous run left
# in out/ and pushes it back through the renderer exactly the way the scaffold's
# runner_render does (the week and the footer line from the saved result). It is
# the loop to use while iterating on how the email looks, and it turns a two
# minute round trip into an instant one. Editing what the email says is the
# other loop, run-local --reuse, which re-asks Claude over the same cached
# pulls.
#
# The node renderer in runners/email does the rendering, rebuilt first whenever
# it is older than its sources, and it writes the plain text part beside the
# page. It has been the only renderer since the jq one retired (ATE-563).
#
# The draft is out/<name>.json, the object the model returned; a runner whose
# email renders from the claude result itself (the pipeline report) has no
# draft, and out/result.json stands in. --json names any other file.
set -euo pipefail

LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
[[ -r "$LIB" ]] || { echo "cannot read $LIB" >&2; exit 1; }
# shellcheck source=lib.sh
. "$LIB"
# The entrypoint side library, for the week math and the footer line, so a
# local re-render carries the same line the run did.
# shellcheck source=../../runners/lib/runner.sh
. "$(runner_entrypoint_lib)"

name=""; week=""; json=""; open_it=1
while (( $# )); do
    case "$1" in
        --week)     week="${2:-}"; shift 2 ;;
        --json)     json="${2:-}"; shift 2 ;;
        --no-open)  open_it=0; shift ;;
        -h|--help)  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)         die "unknown option $1" ;;
        *)          [[ -z "$name" ]] || die "unexpected argument $1"; name="$1"; shift ;;
    esac
done

dir="$(runner_dir "$name")"

work="$dir/out"
if [[ -z "$json" ]]; then
    json="$work/$name.json"
    [[ -s "$json" ]] || json="$work/result.json"
fi
[[ -s "$json" ]] || die "no draft at $json; run 'bin/runner/run-local $name' once first"

# The week the saved draft belongs to, left behind by run-local. An explicit
# --week wins, and today's week is the last resort.
if [[ -z "$week" && -r "$work/week.env" ]]; then
    week="$(sed -n 's/^WEEK=//p' "$work/week.env" | head -1)"
fi
WEEK="${week:-$(current_week)}"
week_bounds "$WEEK" || exit 1

html="$work/email.html"
text="$work/email.txt"
meta="$(meta_line "$work/result.json")"
rm -f "$text"

bundle="$(runner_email_bundle)" || die "could not build the node renderer in runners/email"
node "$bundle" "$name" html --week "$WEEK" --monday "$MONDAY" --sunday "$SUNDAY" --meta "$meta" \
    < "$json" > "$html" || die "the node html render failed"
# Every runner has a plain text part under the node renderer, so a failure here
# is worth saying out loud rather than leaving the file behind empty.
if ! node "$bundle" "$name" text --week "$WEEK" --monday "$MONDAY" --sunday "$SUNDAY" --meta "$meta" \
    < "$json" > "$text"; then
    rm -f "$text"
    echo "the node text render failed; the page above is html only" >&2
fi

[[ -s "$html" ]] || die "render produced nothing"
echo "$WEEK ($MONDAY to $SUNDAY): $(wc -c < "$html" | tr -d ' ') bytes -> $html"
if [[ -s "$text" ]]; then
    echo "$(wc -c < "$text" | tr -d ' ') bytes of plain text -> $text"
fi
if (( open_it )) && command -v open >/dev/null 2>&1; then
    open "$html"
fi
