#!/usr/bin/env bash
# Lists the spans of a Claude Code session's work, read from its transcript:
# every user and assistant message time, split wherever two messages sit more
# than --gap minutes apart. assist:wrap logs these to Toggl with `toggl add`
# (~/Eudaimonia/Admin/Tools/toggl.md, Session Timers), so a session's time is
# the work in it, not how long its window stayed open.
#
#   list-spans [<transcript.jsonl>] [--gap MINUTES] [--date YYYY-MM-DD]
#
# With no transcript it reads the calling session's own, found by the
# CLAUDE_CODE_SESSION_ID Claude Code sets in every shell it starts, so two
# sessions running side by side never read each other's.
#
# One line per span in local time, as two ISO timestamps `toggl add --from --to`
# takes (`2026-11-09T14:00 2026-11-09T15:30`), so a span keeps its own dates,
# midnight crossings included. Every day's spans print unless --date keeps only
# those that start on that day. A span under a minute is dropped, since a lone
# message is not a sitting. The main transcript holds the main thread only,
# so a foreground agent's minutes count only between the messages around it.
set -euo pipefail

usage() {
    echo "usage: list-spans [<transcript.jsonl>] [--gap MINUTES] [--date YYYY-MM-DD]" >&2
    exit 2
}

transcript=""
gap=20
day=""
while [ $# -gt 0 ]; do
    case "$1" in
        --gap) [ $# -ge 2 ] || usage; gap="$2"; shift 2 ;;
        --date) [ $# -ge 2 ] || usage; day="$2"; shift 2 ;;
        -*) usage ;;
        *) [ -z "$transcript" ] || usage; transcript="$1"; shift ;;
    esac
done
case "$gap" in
    '' | *[!0-9]*) echo "list-spans: --gap takes whole minutes" >&2; exit 2 ;;
esac
gap=$((10#$gap))
case "$day" in
    '' | [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) echo "list-spans: --date takes YYYY-MM-DD" >&2; exit 2 ;;
esac

if [ -z "$transcript" ]; then
    if [ -z "${CLAUDE_CODE_SESSION_ID:-}" ]; then
        echo "list-spans: no transcript given and CLAUDE_CODE_SESSION_ID is not set; run it from the session, or name the file" >&2
        exit 2
    fi
    shopt -s nullglob
    found=("$HOME"/.claude/projects/*/"${CLAUDE_CODE_SESSION_ID}".jsonl)
    shopt -u nullglob
    if [ "${#found[@]}" -ne 1 ]; then
        echo "list-spans: expected one transcript for session ${CLAUDE_CODE_SESSION_ID}, found ${#found[@]}" >&2
        exit 1
    fi
    transcript="${found[0]}"
fi
[ -r "$transcript" ] || { echo "list-spans: cannot read $transcript" >&2; exit 1; }

# A line that is not JSON (the last line, mid write, while the session runs)
# or a timestamp in a shape jq cannot read is skipped rather than failing.
jq -R -r '
    fromjson? | select(.type == "user" or .type == "assistant") | .timestamp // empty
    | (try (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) catch empty)
' "$transcript" | sort -n | jq -s -r --argjson gap "$((gap * 60))" --arg day "$day" '
    reduce .[] as $t ([];
        if length > 0 and ($t - .[-1][1]) <= $gap then .[-1][1] = $t else . + [[$t, $t]] end)
    | .[]
    | select($day == "" or (.[0] | strflocaltime("%Y-%m-%d")) == $day)
    | select(.[1] - .[0] >= 60)
    | (.[0] | strflocaltime("%Y-%m-%dT%H:%M")) + " " + (.[1] | strflocaltime("%Y-%m-%dT%H:%M"))
'
