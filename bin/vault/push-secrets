#!/usr/bin/env bash
# Push local credentials to the unified GCP Secret Manager vault.
#
# Usage: push-secrets [<name> ...]   (no names pushes the whole list below)
#
# Vault: three projects, routed per credential by bin/lib/vault.sh. Business
# credentials go to the Atelic org's project, personal ones to the personal
# account's, and the Product Forge set to its own. Override any of them with
# VAULT_PROJECT_ATELIC / VAULT_PROJECT_PERSONAL / VAULT_PROJECT_TPF.
# Naming: kebab case, tool first, then auth type. A vault secret's name
# equals its macOS Keychain service name, verbatim, so there is never a
# mapping table between the local store and the cloud store.
#
# Source order per secret: Keychain service of the same name, then an
# environment variable fallback (name uppercased, dashes to underscores,
# e.g. linear-api-key -> LINEAR_API_KEY).
#
# Values flow stdin only: read into a shell variable, piped straight to
# gcloud --data-file=-; never echoed, never written to disk. Command
# substitution strips the trailing newline the Keychain read appends.
#
# The gws OAuth client files have their own pusher: bin/vault/push-gws-secrets.

set -euo pipefail

VAULT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/vault.sh"
if [[ ! -r "$VAULT_LIB" ]]; then
    echo "cannot read $VAULT_LIB; there is nowhere to push without it" >&2
    exit 1
fi
# shellcheck source=../lib/vault.sh
. "$VAULT_LIB"

# linear-api-key is gone: it was superseded by the workspace qualified names and
# destroyed in the 2026-08-14 vault split. linear-cli-* are not pushed from here
# because they live under one shared Keychain service rather than one per name.
#
# claude-code-oauth is the headless subscription token minted by
# `claude setup-token` (one year life); the local runners read it from Keychain
# and the cloud runner (ATE-471) has it injected from the vault. todoist-api-token
# is seeded by hand: the td CLI keeps its own copy under its own credential
# manager entry, so this name has no local source until Forni adds one
# (Keychain service of the same name, or TODOIST_API_TOKEN in the environment).
SECRETS=(
    resend-api-key
    stripe-api-key
    uptimerobot-api-key
    pinole-mcp-token
    hubspot-service-key-atelic
    hubspot-service-key-tpf
    claude-code-oauth
    ynab-token
    reclaim-api-key
    todoist-api-token
    coldiq-api-key
)

# Names on the command line restrict the push to those credentials, so a
# rotation adds one version to one secret rather than a redundant version to
# every secret in the list (each active version counts against the free tier).
if (( $# > 0 )); then
    SECRETS=("$@")
fi

if ! command -v gcloud >/dev/null 2>&1; then
    echo "gcloud not found on PATH" >&2
    exit 1
fi

ACTIVE_ACCOUNT="$(gcloud config get-value account 2>/dev/null || true)"
: "${ACTIVE_ACCOUNT:=unknown}"

# Reachability is resolved per project, lazily, and memoised. It deliberately is
# NOT checked up front for all three: forni-keys answers to the personal Google
# account while atelic-keys and tpf-keys sit in the atelic.me organisation, so
# no single authenticated identity can reach every vault. A pre-flight loop over
# all three therefore failed closed for whichever account happened to be active
# and pushed nothing at all, which is how the Atelic HubSpot key sat unvaulted
# on 2026-08-17 while the script reported only "forni-keys not accessible".
#
# Space delimited strings rather than associative arrays: the shebang is
# `env bash`, which resolves to bash 3.2 on a Mac without homebrew bash on PATH,
# and 3.2 has no `declare -A`.
VAULT_REACHABLE=""
VAULT_UNREACHABLE=""

vault_reachable() {
    local project="$1"
    case " $VAULT_REACHABLE " in *" $project "*) return 0 ;; esac
    case " $VAULT_UNREACHABLE " in *" $project "*) return 1 ;; esac
    if gcloud projects describe "$project" >/dev/null 2>&1; then
        VAULT_REACHABLE="$VAULT_REACHABLE $project"
        return 0
    fi
    VAULT_UNREACHABLE="$VAULT_UNREACHABLE $project"
    return 1
}

push_value() {
    # Reads the secret value on stdin; creates the secret on first push,
    # adds a version thereafter. The project is resolved by the caller from the
    # routing table, so a personal credential can never land in the business
    # vault by omission.
    local name="$1"
    local project="$2"
    if gcloud secrets describe "$name" --project="$project" >/dev/null 2>&1; then
        gcloud secrets versions add "$name" \
            --data-file=- \
            --project="$project" >/dev/null
        echo "updated $name ($project)"
    else
        gcloud secrets create "$name" \
            --replication-policy=automatic \
            --data-file=- \
            --project="$project" >/dev/null
        echo "created $name ($project)"
    fi
}

pushed=0
skipped=0
blocked=0
for name in "${SECRETS[@]}"; do
    project="$(vault_project_for_secret "$name")"

    value=""
    if ! value=$(security find-generic-password -s "$name" -w 2>/dev/null); then
        env_name=$(printf '%s' "$name" | tr 'a-z-' 'A-Z_')
        value="${!env_name:-}"
    fi

    if [[ -z "$value" ]]; then
        # Expected for vault-only credentials; nothing local to push.
        echo "skip $name: not in Keychain and no env fallback set"
        skipped=$((skipped + 1))
        continue
    fi

    # A vault this identity cannot reach blocks only its own secrets. Every
    # other credential still pushes, so one wrong account no longer means a
    # completely wasted run.
    if ! vault_reachable "$project"; then
        echo "BLOCKED $name: vault $project not reachable as $ACTIVE_ACCOUNT" >&2
        blocked=$((blocked + 1))
        continue
    fi

    printf '%s' "$value" | push_value "$name" "$project"
    pushed=$((pushed + 1))
done

echo
echo "Done. Pushed: $pushed, skipped: $skipped, blocked: $blocked"
echo "Vaults: $VAULT_PROJECT_ATELIC (atelic), $VAULT_PROJECT_PERSONAL (personal), $VAULT_PROJECT_TPF (tpf)"

if (( blocked > 0 )); then
    echo
    echo "$blocked credential(s) were not pushed because their vault is not" >&2
    echo "reachable as $ACTIVE_ACCOUNT. The vaults answer to two different" >&2
    echo "identities, so a full push needs a run as each:" >&2
    echo >&2
    for project in $VAULT_UNREACHABLE; do
        echo "  unreachable: $project" >&2
    done
    echo >&2
    echo "  gcloud auth list                   # see which accounts exist" >&2
    echo "  gcloud config set account <other>  # switch identity" >&2
    echo "  then re-run:" >&2
    echo "  $0" >&2
    exit 1
fi
