#!/usr/bin/env bash
# Per-portal PATH shim around the real `hs` (HubSpot CLI) binary.
#
# Walks up from $PWD finding the nearest .account marker, maps the profile to an
# authenticated HubSpot account, and appends --account before exec'ing the real
# binary. Work in the Atelic subtree therefore hits the Atelic portal, with no
# per directory setup.
#
# Why not `hs account link`, which is the vendor's own mechanism: it writes a
# .hs/settings.json per directory and can only be driven from a TTY, so it
# cannot be set up from an agent shell, a headless run or a fresh machine
# without a human sitting there. It would also need re running for every new
# directory, while the .account markers already describe the split and deploy
# with the repo. The gws shim solved the same problem the same way on
# 2026-08-07; this is that pattern applied to HubSpot (ATE-463).
#
# Precedence, highest first:
#   1. An explicit --account from the caller. Never second guess it.
#   2. Nearest .account marker walking up from $PWD.
#   3. The CLI's own global default, if the marker names no known portal.
#
# `hs api` does not reach the real CLI at all: it is answered here with curl
# and the portal's service key, because the CLI can only authenticate with a
# personal access key and a personal access key cannot carry the scopes the CRM
# reads need. Its scope set is fixed to what the CLI itself uses, cannot be
# edited after issue, and offers nothing for email engagements, so
# /crm/v3/objects/emails is a permanent 403 through the CLI no matter who
# issues the key (confirmed 2026-08-29, twice, on two separate keys). The
# service key has the scopes, including sales-email-read. Everything that is
# not `api` still execs the real binary.
#
# Two consequences worth knowing:
#   - `hs api` now prints the response body and nothing else, where the CLI
#     printed the request line and a "Response:" header first. Piping to jq no
#     longer needs the preamble stripped.
#   - The service key can write, where the personal access key was read only by
#     accident of its scopes. That safety was load bearing and is not given up:
#     anything but a read is refused unless HS_APPLY=1 is set on the
#     invocation, the same speed bump bin/ynab puts in front of YNAB writes.

set -euo pipefail

# Marker parsing and profile resolution are shared with bin/gws and .functions.
# $0 is the invoked path, so this resolves through the ~/bin symlink as well as
# the real repo path.
ACCOUNT_LOG_PREFIX="hs shim"
account_lib="$(dirname "$0")/lib/account-profile.sh"
if [[ -r "$account_lib" ]]; then
    # shellcheck source-path=SCRIPTDIR
    # shellcheck source=lib/account-profile.sh
    . "$account_lib"
else
    account_lib_missing=1
    echo "hs shim: cannot read $account_lib, leaving the account untouched" >&2
fi

# Find the next `hs` on PATH that isn't this shim. The -ef test compares by
# device and inode so reaching this script via ~/bin -> homebase/bin still
# matches, and the -d guard matters because a directory is also -x.
real_hs=""
IFS=':' read -ra path_parts <<< "$PATH"
for p in "${path_parts[@]}"; do
    candidate="$p/hs"
    if [[ -x "$candidate" && ! -d "$candidate" && ! "$candidate" -ef "$0" ]]; then
        real_hs="$candidate"
        break
    fi
done
if [[ -z "$real_hs" ]]; then
    echo "hs shim: cannot find real hs binary on PATH" >&2
    exit 127
fi

# 1. A deliberate --account wins. Unlike the gws shim there is no inherited
#    environment to disambiguate here, because the account arrives as an
#    argument rather than an env var, so its presence is proof of intent.
explicit_account=""
for i in "$@"; do
    case "$i" in
        --account=*|-a=*) explicit_account="${i#*=}" ;;
        --account|-a)     account_next=1 ;;
        *) if [[ -n "${account_next:-}" ]]; then explicit_account="$i"; account_next=""; fi ;;
    esac
done

# A broken install cannot resolve anything. Pass through rather than guessing at
# a portal, since guessing wrong is the failure this shim exists to prevent.
if [[ -n "${account_lib_missing:-}" ]] && [[ -z "$explicit_account" ]]; then
    exec "$real_hs" "$@"
fi

# 2. Marker to portal. This is an explicit table rather than an `hs-pat-$profile`
#    convention because the profiles are named for the identity (personal,
#    atelic) while the portals are named for the businesses. Adding a
#    profile means adding a line here.
#
#    `personal` deliberately maps to nothing. It used to reach the Atelic portal
#    transitionally, while the Atelic subtree had no marker of its own; that
#    marker landed 2026-08-14, so personal life no longer addresses a business
#    CRM and an accidental write from the wrong tree now warns instead.
if [[ -n "${account_lib_missing:-}" ]]; then
    profile=""
else
    profile="$(account_resolve_profile)"
fi
case "$profile" in
    atelic) hs_account="hs-pat-atelic" ;;
    *)      hs_account="" ;;
esac

# An explicit --account names the portal directly and outranks the marker, for
# the service key path as much as for the CLI one.
case "${explicit_account:-$hs_account}" in
    hs-pat-atelic|atelic|246648548) keychain_service="hubspot-service-key-atelic" ;;
    *)                              keychain_service="" ;;
esac

# The service key path. Reached only for `api`, and only when a key for the
# resolved portal is actually in the Keychain; without one this falls back to
# the CLI, which still answers every endpoint its own scopes cover.
if [[ "${1:-}" == "api" && -n "$keychain_service" ]]; then
    # The parser below consumes every argument, so the original line is kept
    # whole for the fallback at the bottom: without it the CLI would be handed
    # a bare endpoint with the `api` subcommand already shifted away.
    original_args=("$@")
    shift
    endpoint=""; method=""; data=""; want_account=""
    while (( $# )); do
        case "$1" in
            -X|--method)        method="${2:-}"; shift 2 ;;
            -X=*|--method=*)    method="${1#*=}"; shift ;;
            --data)             data="${2:-}"; shift 2 ;;
            --data=*)           data="${1#*=}"; shift ;;
            -a|--account)       want_account="${2:-}"; shift 2 ;;
            -a=*|--account=*)   want_account="${1#*=}"; shift ;;
            --json|--format-output-as-json|-d|--debug|--use-env) shift ;;
            -c|--config)        shift 2 ;;
            -h|--help)          exec "$real_hs" api --help ;;
            *)                  [[ -n "$endpoint" ]] || endpoint="$1"; shift ;;
        esac
    done
    : "${want_account:=}"

    if [[ -z "$endpoint" ]]; then
        echo "hs shim: hs api needs an endpoint" >&2
        exit 2
    fi

    # Matching the CLI's own default: GET, unless a body was given.
    if [[ -z "$method" ]]; then
        if [[ -n "$data" ]]; then method="POST"; else method="GET"; fi
    fi
    method="$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')"

    # HubSpot answers several genuinely read only endpoints over POST, so the
    # write gate keys on what the call does rather than on its verb alone.
    is_read=0
    [[ "$method" == "GET" ]] && is_read=1
    if [[ "$method" == "POST" ]]; then
        case "${endpoint%%\?*}" in
            */search|*/batch/read) is_read=1 ;;
        esac
    fi
    if (( ! is_read )) && [[ "${HS_APPLY:-0}" != "1" ]]; then
        echo "hs shim: refusing $method ${endpoint%%\?*}: the service key can write to the CRM." >&2
        echo "hs shim: set HS_APPLY=1 on this invocation to mean it." >&2
        exit 3
    fi

    key="$(security find-generic-password -s "$keychain_service" -w 2>/dev/null || true)"
    if [[ -z "$key" ]]; then
        echo "hs shim: no Keychain entry '$keychain_service'; falling back to the CLI, whose scopes are narrower" >&2
        set -- "${original_args[@]}"
    else
        body="$(mktemp)"
        trap 'rm -f "$body"' EXIT
        code="$(curl -sS --max-time 60 -o "$body" -w '%{http_code}' \
            -X "$method" \
            -H "Authorization: Bearer $key" \
            -H "Content-Type: application/json" \
            ${data:+--data "$data"} \
            "https://api.hubapi.com/${endpoint#/}")" || { echo "hs shim: request to $endpoint failed" >&2; exit 1; }
        cat "$body"
        [[ "$code" =~ ^2 ]] || { echo "hs shim: HTTP $code from ${endpoint%%\?*}" >&2; exit 1; }
        exit 0
    fi
fi

# Everything that is not `api`, and `api` with no service key to answer it, goes
# to the real binary. An explicit --account is already on the command line.
if [[ -n "$explicit_account" ]]; then
    exec "$real_hs" "$@"
fi

# 3. An unmapped profile falls through to the CLI's global default rather than
#    picking a portal on the caller's behalf. Writing to the wrong CRM is the
#    expensive mistake here, so say so and let the default stand.
if [[ -z "$hs_account" ]]; then
    echo "hs shim: profile '$profile' maps to no HubSpot portal, using the CLI default" >&2
    exec "$real_hs" "$@"
fi

exec "$real_hs" "$@" --account="$hs_account"
