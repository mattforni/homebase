#!/usr/bin/env bash
# Table test for the call back: .claude/hooks/call-back.sh arms a detached
# timer when a session starts waiting on the user, and bin/call/back rings.
# Each row drives the hook with canned stdin against its own throwaway $HOME,
# with a one second threshold and CALL_BACK_DRY_RUN=1, so nothing makes a
# sound; a ring is a line in that home's rings.log. Run by CI and by hand.
set -uo pipefail

REPO=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel 2>/dev/null) \
  || { echo "not in a git repo"; exit 1; }
HOOK="$REPO/.claude/hooks/call-back.sh"
BACK="$REPO/bin/call/back"
[[ -x "$HOOK" ]] || { echo "hook missing or not executable: $HOOK"; exit 1; }
[[ -x "$BACK" ]] || { echo "back missing or not executable: $BACK"; exit 1; }
command -v jq &>/dev/null || { echo "jq is required"; exit 1; }

TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
pass=0; fail=0
ok() { pass=$((pass + 1)); }
bad() { fail=$((fail + 1)); printf '  FAIL %s\n' "$1"; }

# Run the hook as an attended interactive session would, in home $1, with
# the hook input built from the remaining jq arguments. Extra environment
# goes in HOOK_ENV as NAME=value words.
hook() {
  local home="$TMP/$1"; shift
  mkdir -p "$home"
  # shellcheck disable=SC2086
  jq -cn "$@" | env -u CLAUDE_PROJECT_DIR -u CLAUDE_CODE_REMOTE \
    HOME="$home" CALL_BACK_AFTER_SECONDS=1 CALL_BACK_DRY_RUN=1 \
    CLAUDE_CODE_SESSION_ATTENDED=1 CLAUDE_CODE_ENTRYPOINT=cli \
    ${HOOK_ENV:-} "$HOOK" >/dev/null 2>&1
  local rc=$?
  [[ $rc -eq 0 ]] || bad "$home: hook exited $rc"
}

stop() { # home message [jq filter applied to the input]
  local extra="${3:-.}"
  hook "$1" --arg m "$2" "{hook_event_name:\"Stop\",session_id:\"s1\",cwd:\"/work/homebase\",stop_hook_active:false,last_assistant_message:\$m} | $extra"
}
prompt() { hook "$1" '{hook_event_name:"UserPromptSubmit",session_id:"s1",cwd:"/work/homebase",prompt:"yes"}'; }
ask() { hook "$1" '{hook_event_name:"PreToolUse",session_id:"s1",cwd:"/work/homebase",tool_name:"AskUserQuestion",tool_input:{questions:[]}}'; }
answered() { hook "$1" '{hook_event_name:"PostToolUse",session_id:"s1",cwd:"/work/homebase",tool_name:"AskUserQuestion",tool_input:{questions:[]}}'; }

# Rows: each arms (or does not) in its own home. The timers all run at once.
stop q "Want me to land it?"
stop statement "Landed it. Nothing is waiting on you."
stop cancel "Want me to land it?"; prompt cancel
mkdir -p "$TMP/off/.claude"; touch "$TMP/off/.claude/call-back.off"; stop off "Want me to land it?"
stop subagent "Should I keep going?" '. + {agent_id:"agent-1",agent_type:"Explore"}'
hook subagentstop '{hook_event_name:"SubagentStop",session_id:"s1",cwd:"/work/homebase",agent_id:"a1",stop_hook_active:false,last_assistant_message:"Done?"}'
stop continuation "Should I keep going?" '.stop_hook_active = true'
HOOK_ENV="CLAUDE_CODE_SESSION_ATTENDED=0 CLAUDE_CODE_ENTRYPOINT=sdk-cli" stop headless "Should I keep going?"
HOOK_ENV="CLAUDE_CODE_SESSION_ATTENDED= CLAUDE_CODE_ENTRYPOINT=sdk-ts" stop sdk "Should I keep going?"
HOOK_ENV="CLAUDE_CODE_REMOTE=true" stop cloud "Should I keep going?"
stop markdown $'Here is the plan.\n\n**Shall I start?**\n\n'
stop midway $'Is this right? I checked.\n\nAll three tests pass.'
stop worktree "Ready?" '.cwd = "/work/homebase/.claude/worktrees/call-back"'
HOOK_ENV="CLAUDE_PROJECT_DIR=/work/eudy" stop projectdir "Ready?"
ask dialog
ask dialogdone; answered dialogdone
stop ended "Ready?"; hook ended '{hook_event_name:"SessionEnd",session_id:"s1",cwd:"/work/homebase",reason:"other"}'
stop reported "Ready?"; stop reported "Done, nothing more."
stop nomessage "" 'del(.last_assistant_message)'
stop badsid "Ready?" '.session_id = "../../escape"'
for junk in "" "not json" '{"hook_event_name":"Stop"}'; do
  if printf '%s' "$junk" | HOME="$TMP/junk" "$HOOK" >/dev/null 2>&1; then ok; else bad "junk input made the hook fail: $junk"; fi
done

sleep 2.5

# grep -c prints 0 and exits 1 on no match, so its status is ignored.
count() { local f="$TMP/$1/.claude/call-back/rings.log"; if [[ -f "$f" ]]; then grep -cF -- "$2" "$f"; else echo 0; fi; return 0; }
rings() { count "$1" ' ring '; }
said() { count "$1" "call-back: say $2"; }
expect_rings() { # home count why
  local got; got=$(rings "$1")
  if [[ "$got" == "$2" ]]; then ok; else bad "$1: want $2 ring(s), got $got ($3)"; fi
}

expect_rings q 1 "a turn ending in a question rings once"
[[ $(said q "homebase is waiting on you.") == 1 ]] && ok || bad "q: the line names the project folder"
expect_rings statement 0 "a turn ending in a statement never rings"
expect_rings cancel 0 "typing before the threshold cancels"
expect_rings off 1 "the timer still fires under the kill switch"
[[ $(said off "") == 0 ]] && grep -q 'call-back: off' "$TMP/off/.claude/call-back/rings.log" && ok \
  || bad "off: the kill switch silences the ring"
expect_rings subagent 0 "a subagent's stop never rings"
expect_rings subagentstop 0 "SubagentStop never rings"
expect_rings continuation 0 "a stop hook continuation never rings"
expect_rings headless 0 "claude -p never rings"
expect_rings sdk 0 "an SDK host never rings"
expect_rings cloud 0 "a cloud session never rings"
expect_rings markdown 1 "a bold question with trailing blank lines rings"
expect_rings midway 0 "a question above a closing statement does not ring"
[[ $(said worktree "homebase is waiting on you.") == 1 ]] && ok || bad "worktree: named by its repo"
[[ $(said projectdir "eudy is waiting on you.") == 1 ]] && ok || bad "projectdir: CLAUDE_PROJECT_DIR wins over cwd"
expect_rings dialog 1 "an open AskUserQuestion dialog rings"
expect_rings dialogdone 0 "an answered dialog does not ring"
expect_rings ended 0 "a session that ended does not ring"
expect_rings reported 0 "a later plain report disarms"
expect_rings nomessage 0 "no last message, no ring"
[[ -f "$TMP/badsid/.claude/call-back/escape.stamp" || $(rings badsid) == 1 ]] && ok \
  || bad "badsid: the session id is sanitised into the stamp directory"
[[ ! -e "$TMP/escape.stamp" && ! -e "$TMP/badsid/escape.stamp" ]] && ok || bad "badsid: a stamp escaped its directory"

# A second stop replaces the first stamp: the first timer wakes to find it
# gone and stays quiet, and the second rings once, on its own clock. Run on
# its own with a three second threshold: the check lands after the first
# timer wakes and before the second does, as long as one hook run takes
# under two seconds, which leaves room for a slow runner.
HOOK_ENV="CALL_BACK_AFTER_SECONDS=3" stop twice "First question?"
sleep 1
HOOK_ENV="CALL_BACK_AFTER_SECONDS=3" stop twice "Second question?"
sleep 2.3
expect_rings twice 0 "the first timer finds its stamp replaced"
sleep 2
expect_rings twice 1 "the second stamp rings once"

# A ring removes its stamp, so nothing is left to ring again.
[[ ! -e "$TMP/q/.claude/call-back/s1.stamp" ]] && ok || bad "q: the stamp outlived its ring"

# Stamps older than a day are pruned on the next hook run.
mkdir -p "$TMP/prune/.claude/call-back"
touch -t 202001010000 "$TMP/prune/.claude/call-back/old.stamp"
prompt prune
[[ ! -e "$TMP/prune/.claude/call-back/old.stamp" ]] && ok || bad "prune: a day old stamp survived"

# bin/call/back on its own.
out=$(HOME="$TMP/b" "$BACK" --dry-run "Come back.")
[[ $(grep -c 'call-back: chime' <<<"$out") == 2 && $(grep -c 'call-back: say Come back.' <<<"$out") == 1 ]] && ok \
  || bad "back: two chimes then the line"
out=$(HOME="$TMP/b" "$BACK" --dry-run --quiet-chime "Come back.")
grep -q 'volume 0.25' <<<"$out" && ok || bad "back: --quiet-chime lowers the chime"
out=$(HOME="$TMP/b" CALL_BACK_DRY_RUN=1 "$BACK" $'two\n  lines')
grep -q 'call-back: say two lines$' <<<"$out" && ok || bad "back: the message folds to one line"
mkdir -p "$TMP/boff/.claude"; touch "$TMP/boff/.claude/call-back.off"
out=$(HOME="$TMP/boff" "$BACK" --dry-run "Come back.")
[[ "$out" == *"call-back: off"* && "$out" != *say* ]] && ok || bad "back: the kill switch silences"
HOME="$TMP/b" "$BACK" --dry-run >/dev/null 2>&1; [[ $? -eq 2 ]] && ok || bad "back: no message is a usage error"

echo "call-back-test: $pass passed, $fail failed"
[[ $fail -eq 0 ]]
