#!/usr/bin/env bash
# Table test for .claude/hooks/secrets-gate.sh: every command that would print
# a credentials file is denied, and every count, metadata read, or between
# process move is allowed. Run by CI and by hand; add a row for each new way
# a secret nearly printed.
set -uo pipefail

REPO=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel 2>/dev/null) \
  || { echo "not in a git repo"; exit 1; }
HOOK="$REPO/.claude/hooks/secrets-gate.sh"
[[ -x "$HOOK" ]] || { echo "hook missing or not executable: $HOOK"; exit 1; }

pass=0; fail=0
expect() {
  local want="$1" cmd="$2" out decision
  out=$(jq -cn --arg c "$cmd" '{tool_name:"Bash",tool_input:{command:$c},cwd:"/tmp"}' | "$HOOK" 2>/dev/null)
  decision=$(jq -r '.hookSpecificOutput.permissionDecision // "allow"' <<<"${out:-{\}}" 2>/dev/null)
  if [[ "$decision" == "$want" ]]; then
    pass=$((pass + 1))
  else
    fail=$((fail + 1))
    printf '  FAIL want %-5s got %-5s  %s\n' "$want" "$decision" "$cmd"
  fi
}

F='runners/pipeline/.env.local'

# Must deny: anything that emits the file's bytes.
expect deny "cat $F"
expect deny "head -5 $F"
expect deny "tail -n 20 $F"
expect deny "cut -d= -f1 $F"
expect deny "cut -d= -f1 $F | sed 's/^/  /'"
expect deny "sed -n 1,5p $F"
expect deny "awk '{print \$1}' $F"
expect deny "grep export $F"
expect deny "grep -n RESEND $F"
expect deny "cat $F | wc -c"
expect deny "less $F"
expect deny "python3 -c 'print(open(\"$F\").read())'"
expect deny "base64 $F"
expect deny "echo \"\$(cat $F)\""
expect deny "sort $F"
expect deny "jq . ~/.config/gws-atelic/client_secret.json"
expect deny "cat ~/.config/gws-atelic/credentials.enc"
expect deny "cat \$H/runners/retro/.env.local"
expect deny "bat $F"
expect deny "cd runners/pipeline && cat .env.local"
expect deny "sleep 1 & cat $F"
expect deny "dd if=$F"
expect deny "cat $F SECRETS_GATE_BYPASS=1"
expect deny "echo SECRETS_GATE_BYPASS=1; cat $F"

# Must allow: counts, metadata, the shell reading it, and moves that never echo.
expect allow "grep -c '^export ' $F"
expect allow "grep -q RESEND_API_KEY $F && echo present"
expect allow "grep -l RESEND $F"
expect allow "wc -c $F"
expect allow "wc -c < $F"
expect allow "stat -f '%Lp' $F"
expect allow "ls -la $F"
expect allow "git check-ignore $F"
expect allow "test -s $F && echo yes"
expect allow ". $F && bin/runner/run-local pipeline"
expect allow "source $F"
expect allow "rm -f $F"
expect allow "chmod 600 $F"
expect allow "bin/runner/fetch-env pipeline"
expect allow "gcloud secrets versions access latest --secret=x --project=p | python3 -c 'import sys; print(len(sys.stdin.read()))'"
expect allow "cat runners/README.md"
expect allow "cut -d= -f1 runners/pipeline/week.env"
expect allow "SECRETS_GATE_BYPASS=1 cat $F"
expect allow "cp $F $F.bak"
expect allow "diff <(cut -d= -f1 runners/retro/week.env) /dev/null"

echo "secrets gate: $pass passed, $fail failed"
[[ $fail -eq 0 ]]
