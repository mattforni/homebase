#!/usr/bin/env bash
# Checks the two things about a runner that no other gate can see and that
# drift silently when they go wrong.
#
# Both exist because of the 2026-08-31 Plumber outage, where the Monday job
# had never once reached its agent. A rule written in a comment is the weakest
# form of a rule; this is the same rule, enforced.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
GREEN='\033[0;32m'; RED='\033[0;31m'; NC='\033[0m'
failed=0

fail() { printf "${RED}[x]${NC} %s\n" "$1" >&2; failed=1; }

# shellcheck source=../runner/lib.sh
. "$ROOT/bin/runner/lib.sh"

expected_path="$(runner_local_path)"
# The plists are templates, so compare in their own vocabulary rather than
# rendering: {{HOME}} is what setup.sh substitutes at install time.
expected_template="${expected_path//$HOME/\{\{HOME\}\}}"

shopt -s nullglob
for plist in "$ROOT"/launchagents/*.plist; do
    label="$(basename "$plist" .plist)"

    # 1. The PATH is stated in two places that cannot read each other:
    #    runner_local_path, and the plist's own EnvironmentVariables. launchd
    #    starts a job with an empty environment and never sources a shell, so
    #    the plist cannot inherit it, and a plist whose PATH has fallen behind
    #    fails in preflight at 06:00 on a morning nobody is watching.
    actual_path="$(sed -n '/<key>PATH<\/key>/{n;s/.*<string>\(.*\)<\/string>.*/\1/p;}' "$plist")"
    if [[ -z "$actual_path" ]]; then
        fail "$label sets no PATH; launchd hands a job an empty environment"
    elif [[ "$actual_path" != "$expected_template" ]]; then
        fail "$label PATH has drifted from runner_local_path in bin/runner/lib.sh"
        printf "      plist: %s\n" "$actual_path" >&2
        printf "      lib:   %s\n" "$expected_template" >&2
    fi

    # 2. A plist driving run-scheduled has to name a runner that exists. The
    #    argument is a bare string in XML, so a rename or a typo is invisible
    #    until the job fires and dies.
    if grep -q 'run-scheduled' "$plist"; then
        name="$(sed -n '/run-scheduled<\/string>/{n;s/.*<string>\(.*\)<\/string>.*/\1/p;}' "$plist")"
        if [[ -z "$name" ]]; then
            fail "$label calls run-scheduled with no runner name"
        elif [[ ! -x "$ROOT/runners/$name/entrypoint.sh" ]]; then
            fail "$label names runner '$name', which has no executable runners/$name/entrypoint.sh"
        else
            # 3. The check above reads the repo directly. launchd does not: it
            #    runs the path the plist names, and on a real machine $HOME/bin
            #    is a symlink to this repo's bin/. A repo root computed with a
            #    logical `..` then walks the symlink's parent instead of the
            #    real one and every runner resolves against $HOME/runners,
            #    which does not exist. That shipped in #215 and would have
            #    failed on a Monday before writing a single line anyone reads.
            #
            #    So resolve the runner the way launchd will, through a symlink
            #    to the tree under test rather than to whatever is deployed:
            #    this has to fail on the branch that breaks it, not one release
            #    later.
            link_dir="$(mktemp -d)"
            ln -s "$ROOT/bin" "$link_dir/bin"
            if ! ( . "$link_dir/bin/runner/lib.sh" && runner_dir "$name" ) >/dev/null 2>&1; then
                fail "$label names runner '$name', which does not resolve when reached through a symlink (as $HOME/bin is)"
            fi
            rm -rf "$link_dir"
        fi
    fi
done

# 3. Every runner's entrypoint is executable in the tree, not only in its
#    image. run-local and run-scheduled exec it directly and git tracks the
#    bit, so a 100644 entrypoint works inside the Dockerfile (which chmods its
#    copy) and fails on every fresh clone with "Permission denied". The retro's
#    was tracked without the bit until 2026-09-03, and the check above only
#    reached runners a plist named.
for entry in "$ROOT"/runners/*/entrypoint.sh; do
    [[ -x "$entry" ]] || fail "${entry#"$ROOT"/} is not executable; fix with git update-index --chmod=+x"
done

if [[ $failed -eq 0 ]]; then
    printf "${GREEN}[+]${NC} Runner checks clean\n"
fi
exit "$failed"
